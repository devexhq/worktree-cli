{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://src.io/schemas/v1/config.json",
  "title": "Worktree Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project",
    "paths",
    "sandbox",
    "agent",
    "history",
    "doctor",
    "prune",
    "telemetry"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initialized_at"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "initialized_at": { "type": ["string", "null"] }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_dir",
        "sessions_dir",
        "artifacts_dir",
        "db_path"
      ],
      "properties": {
        "root_dir": { "type": "string", "minLength": 1 },
        "sessions_dir": { "type": "string", "minLength": 1 },
        "artifacts_dir": { "type": "string", "minLength": 1 },
        "db_path": { "type": "string", "minLength": 1 }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_ref",
        "max_active_sandboxes",
        "default_timeout_seconds"
      ],
      "properties": {
        "base_ref": { "type": "string", "minLength": 1 },
        "max_active_sandboxes": { "type": "integer", "minimum": 1 },
        "default_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "endpoint",
        "temperature",
        "max_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "local",
            "ollama",
            "cursor",
            "gemini",
            "copilot",
            "openai",
            "anthropic",
            "azure_openai",
            "custom"
          ]
        },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "endpoint": { "type": ["string", "null"], "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "save_attempt_logs",
        "save_agent_payloads",
        "save_final_diff",
        "max_sessions"
      ],
      "properties": {
        "save_attempt_logs": { "type": "boolean" },
        "save_agent_payloads": { "type": "boolean" },
        "save_final_diff": { "type": "boolean" },
        "max_sessions": { "type": "integer", "minimum": 1 }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_git",
        "check_paths_writable",
        "check_config_schema",
        "check_stale_worktrees",
        "check_required_binaries"
      ],
      "properties": {
        "check_git": { "type": "boolean" },
        "check_paths_writable": { "type": "boolean" },
        "check_config_schema": { "type": "boolean" },
        "check_stale_worktrees": { "type": "boolean" },
        "check_required_binaries": { "type": "boolean" }
      }
    },
    "prune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remove_stale_worktrees",
        "remove_orphaned_sandboxes",
        "remove_expired_artifacts",
        "artifact_ttl_days"
      ],
      "properties": {
        "remove_stale_worktrees": { "type": "boolean" },
        "remove_orphaned_sandboxes": { "type": "boolean" },
        "remove_expired_artifacts": { "type": "boolean" },
        "artifact_ttl_days": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}
